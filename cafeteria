class Persona:
    total_personas = 0

    def __init__(self, idPersona, nombre, email):
        self._idPersona = idPersona
        self._nombre = nombre
        self._email = email
        Persona.total_personas += 1

    def login(self):
        raise NotImplementedError

    def actualizarPerfil(self, nombre, email):
        self._nombre = nombre
        self._email = email

    def __eq__(self, other):
        return isinstance(other, Persona) and self._idPersona == other._idPersona

    def __str__(self):
        return self._nombre

    def __repr__(self):
        return f"Persona({self._idPersona}, {self._nombre})"


class Cliente(Persona):

    def __init__(self, idPersona, nombre, email):
        super().__init__(idPersona, nombre, email)
        self.puntosFidelidad = 0
        self.historialPedidos = []

    def login(self):
        return f"Cliente {self._nombre} inició sesión"

    def realizarPedido(self, pedido):
        self.historialPedidos.append(pedido)

    def consultarHistorial(self):
        return self.historialPedidos

    def canjearPuntos(self, puntos):
        if self.puntosFidelidad >= puntos:
            self.puntosFidelidad -= puntos
            return "Puntos canjeados"
        return "No tienes suficientes puntos"


