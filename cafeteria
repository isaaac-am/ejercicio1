class ProductoBase:

    def __init__(self, idProducto, nombre, precioBase):
        self.idProducto = idProducto
        self.nombre = nombre
        self.precioBase = precioBase

    def __str__(self):
        return f"{self.nombre} - ${self.precioBase}"

    def __repr__(self):
        return f"Producto({self.nombre})"


class Bebida(ProductoBase):

    def __init__(self, idProducto, nombre, precioBase, tamaño, temperatura):
        super().__init__(idProducto, nombre, precioBase)
        self.tamaño = tamaño
        self.temperatura = temperatura
        self.modificadores = []

    def agregarExtra(self, extra, costo):
        self.modificadores.append((extra, costo))

    def calcularPrecioFinal(self):
        total = self.precioBase
        for extra in self.modificadores:
            total += extra[1]
        return total


class Postre(ProductoBase):

    def __init__(self, idProducto, nombre, precioBase, esVegano, sinGluten):
        super().__init__(idProducto, nombre, precioBase)
        self.esVegano = esVegano
        self.sinGluten = sinGluten


class Pedido:
    total_pedidos = 0

    def __init__(self, productos):
        Pedido.total_pedidos += 1
        self.idPedido = Pedido.total_pedidos
        self.productos = productos
        self.estado = "PENDIENTE"
        self.total = 0

    def calcularTotal(self):
        total = 0
        for p in self.productos:
            if isinstance(p, Bebida):
                total += p.calcularPrecioFinal()
            else:
                total += p.precioBase
        self.total = total
        return total

    def validarStock(self):
        return True

    def __add__(self, other):
        return Pedido(self.productos + other.productos)

    def __mul__(self, n):
        return Pedido(self.productos * n)

    def __eq__(self, other):
        return self.idPedido == other.idPedido

    def __str__(self):
        return f"Pedido {self.idPedido} - Total: ${self.total}"

    def __repr__(self):
        return f"Pedido({self.idPedido})"


class Inventario:

    def __init__(self):
        self.ingredientes = {}

    def reducirStock(self, ingrediente, cantidad):
        if self.ingredientes.get(ingrediente, 0) >= cantidad:
            self.ingredientes[ingrediente] -= cantidad
        else:
            self.notificarFaltante(ingrediente)

    def notificarFaltante(self, ingrediente):
        print(f"Falta el ingrediente: {ingrediente}")
